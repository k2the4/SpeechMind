# Copy this file to .env and add only the keys you personally create.
# Never commit .env or share API keys in screenshots/logs.

# Privacy-first default: runs local Whisper Small on this PC.
SPEECHMIND_ASR_BACKEND=whisper
SPEECHMIND_WHISPER_MODEL=small

# To opt in to hosted code-switch-aware Indian ASR:
# 1. Create an account/key at https://console.bodhan.ai/
# 2. Check pricing/privacy terms.
# 3. Set backend to bodhan and paste the key below.
# SPEECHMIND_ASR_BACKEND=bodhan
# BODHAN_ASR_API_KEY=

# Translation defaults to auto:
# - If a Bodhan translation key is configured, code-mixed text is sent for English translation.
# - Otherwise, local IndicTrans2 is only used for supported Indic-script input.
SPEECHMIND_TRANSLATION_BACKEND=auto
# BODHAN_TRANSLATE_API_KEY=

# Optional shared API key if the same key has access to both products:
# BODHAN_API_KEY=

BODHAN_API_BASE_URL=https://api.bodhan.ai/v1
BODHAN_ASR_MODEL=indic-transcribe
